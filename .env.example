# NexusForge 2.0 Configuration Example

# System Settings
NEXUSFORGE_ENV=development
NEXUSFORGE_LOG_LEVEL=INFO

# Dashboard Settings
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Agent Settings
MAX_AGENT_DEPTH=5
SPAWN_THRESHOLD=0.7

# Optional: API Keys for enhanced capabilities
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
